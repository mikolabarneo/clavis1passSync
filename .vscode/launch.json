{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: app.py (debug, port 5050)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_RUN_PORT": "5050",
                "FLASK_SECRET_KEY": "local-dev-only-not-secret",
                "SESSION_COOKIE_SECURE": "false"
            },
            "args": [],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}
